# HA Configuration Example
# Copy to .env.ha and adjust for your setup

# === ENABLE/DISABLE HA ===
HA_ENABLED=true
HA_ROLE=PRIMARY

# === MACHINE IDENTIFICATION ===
# Set these to YOUR machine hostnames/IPs
HA_PRIMARY_HOST=192.168.1.100
HA_BACKUP_HOST=192.168.1.101

# === NETWORK PORTS ===
HA_PRIMARY_PORT=9998
HA_BACKUP_PORT=9999

# === STATE SYNCHRONIZATION ===
# How often PRIMARY syncs state to BACKUP (seconds)
HA_SYNC_INTERVAL=5.0

# How long to wait for sync acknowledgment (seconds)
HA_SYNC_TIMEOUT=10.0

# How many times to retry failed sync
HA_SYNC_RETRIES=3

# === HEARTBEAT MONITORING ===
# How often PRIMARY sends heartbeat (seconds)
HA_HEARTBEAT_INTERVAL=5.0

# How long BACKUP waits for next heartbeat (seconds)
# Should be slightly more than interval (5.0 + 1.0 grace = 6.0)
HA_HEARTBEAT_TIMEOUT=6.0

# How many consecutive missed beats = PRIMARY is dead
# 3 missed beats × 5 seconds = 15 seconds to detect failure
HA_HEARTBEAT_THRESHOLD=3

# === FAILOVER SETTINGS ===
# Validate state consistency before promotion
HA_FAILOVER_VALIDATION=true

# Minimum percentage of globals that must be synced (0.80 = 80%)
# If coverage < 80%, failover is aborted (too much state lost)
HA_FAILOVER_MIN_STATE_COVERAGE=0.80

# How long failover can take before aborting (seconds)
HA_FAILOVER_TIMEOUT=60.0

# Resume trading immediately after promotion (true) or wait for manual signal (false)
HA_RESUME_IMMEDIATELY=true

# How long to wait for incomplete orders before timing out (seconds)
HA_INCOMPLETE_ORDER_TIMEOUT=30.0

# === LOGGING ===
HA_LOG_LEVEL=INFO
HA_LOG_FILE=logs/ha.log

# === MONITORING & METRICS ===
HA_EXPORT_METRICS=true
HA_METRICS_PORT=8888

# ===== MACHINE-SPECIFIC OVERRIDES =====
# PRIMARY (machine1.local):
# HA_ROLE=PRIMARY
# HA_PRIMARY_HOST=machine1.local
# HA_BACKUP_HOST=machine2.local

# BACKUP (machine2.local):
# HA_ROLE=BACKUP
# HA_PRIMARY_HOST=machine1.local
# HA_BACKUP_HOST=machine2.local
